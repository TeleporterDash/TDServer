{
  "name": "tdserver",
  "version": "1.0.0",
  "description": "The official Teleporter Dash server",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "kv:create": "wrangler kv namespace create TELEPORTER_LEVELS",
    "kv:create-music": "wrangler kv namespace create TELEPORTER_MUSIC",
    "r2:create": "wrangler r2 bucket create teleporterdash-audio",
    "migrate:levels": "tsx scripts/migrate-levels.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251001.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
