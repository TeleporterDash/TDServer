{
  "name": "tdserver",
  "version": "1.0.0",
  "description": "The official Teleporter Dash server",
  "type": "module",
  "scripts": {
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "kv:create": "wrangler kv namespace create TELEPORTER_LEVELS",
    "kv:create-music": "wrangler kv namespace create TELEPORTER_MUSIC",
    "r2:create": "wrangler r2 bucket create teleporterdash-audio"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261108.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "wrangler": "^4.158.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
